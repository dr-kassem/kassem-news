# --- KASSEM NEWS backend configuration (copy to .env) ---

# Core
ENVIRONMENT=development
DEBUG=true

# Database: SQLite for local dev, PostgreSQL for production.
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://kassem:kassem@localhost:5432/kassem_news
DATABASE_URL=sqlite:///./kassem_news.db

# Security (MUST be changed in production)
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Bootstrap admin (used only by `python -m app.seed`)
ADMIN_EMAIL=admin@kassem.news
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=مدير التحرير

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# Ingestion
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=15
INGESTION_TIMEOUT_SECONDS=20
INGESTION_MAX_RETRIES=3
INGESTION_USER_AGENT=KassemNewsBot/1.0 (+https://kassem.news/bot)

# Optional external API credentials (leave empty if unused)
# NEWSAPI_KEY=
# GNEWS_KEY=

# --- AI (OpenRouter, OpenAI-compatible) ---
# Free key: https://openrouter.ai/keys — keep it server-side only.
OPENROUTER_API_KEY=
AI_MODEL=google/gemma-4-31b-it:free
AI_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,xingchen-agi/xing4.0-29b-a4b:free
AI_TIMEOUT_SECONDS=90
AI_SUMMARIZE_ON_INGEST=false
AI_INGEST_MAX_PER_RUN=20


SITE_URL=https://kassem-news.onrender.com
# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Security (MUST be changed) ---
# Generate one, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Bootstrap admin (used by `python -m app.seed` on first boot) ---
ADMIN_EMAIL=admin@kassem.news
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Ingestion ---
INGESTION_INTERVAL_MINUTES=15

# --- AI (OpenRouter, OpenAI-compatible) ---
# Free key: https://openrouter.ai/keys — server-side only, never in the frontend.
OPENROUTER_API_KEY=
AI_MODEL=google/gemma-4-31b-it:free
AI_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,xingchen-agi/xing4.0-29b-a4b:free
AI_TIMEOUT_SECONDS=90
AI_SUMMARIZE_ON_INGEST=false
AI_INGEST_MAX_PER_RUN=20
